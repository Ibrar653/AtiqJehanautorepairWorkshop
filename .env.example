# ==============================================================================
# ATIQ JEHAN AUTO REPAIR Workshop Management System
# Production Environment Variables Template (.env.example)
#
# IMPORTANT:
# - NEVER commit actual production secrets to Git.
# - On Vercel: Add these variables under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Required)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public / Anon API Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Publishable Key (alternative modern format, optional if anon key is set)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 2. Server-Side Supabase Secret Key (Required for Server Admin / Direct User Creation)
# ------------------------------------------------------------------------------
# Elevated administrative secret (starts with sb_secret_...) used EXCLUSIVELY on the server.
# NEVER expose this key via NEXT_PUBLIC_* or to client-side code.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy fallback:
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Application Public Domain / Base URL (Required for Live Production)
# ------------------------------------------------------------------------------
# The fully-qualified HTTPS production URL (e.g. https://atiqjehan-workshop.vercel.app)
# Used for generating staff invitations, password reset links, and auth redirects.
# In local development, use: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
